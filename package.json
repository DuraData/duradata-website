{
  "name": "duradata-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "academy"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace academy",
    "dev:legacy": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "npm run build --workspace academy",
    "start": "npm run start --workspace academy",
    "lint": "npm run lint --workspace academy",
    "typecheck": "npm run typecheck --workspace academy",
    "test": "npm run test:unit --workspace academy",
    "test:unit": "npm run test:unit --workspace academy",
    "test:e2e": "npm run test:e2e --workspace academy",
    "db:generate": "npm run db:generate --workspace academy",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace academy",
    "db:seed": "npm run db:seed --workspace academy",
    "preview": "npm run build && npm run start"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
