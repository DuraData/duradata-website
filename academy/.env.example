# Copy to .env.local for development. In Hostinger, add the production values
# to the Node.js application's Environment variables instead of committing them.

# --- Academy database (new, isolated MySQL database) -------------------
# Never point these variables at the original LMS database.
ACADEMY_DATABASE_URL="mysql://user:password@mysql.example:3306/duradata_academy?sslmode=require"
# Optional direct URL for migrations when the runtime URL uses a proxy.
ACADEMY_DIRECT_DATABASE_URL="mysql://user:password@mysql.example:3306/duradata_academy?sslmode=require"
# Optional PEM CA for providers using a private certificate authority. Encode
# line breaks as \n inside a single-line environment value.
DATABASE_CA_CERT=""

# Destructive automated tests are permitted only when the database name or
# schema contains "test". Never set this to production or development data.
ACADEMY_TEST_DATABASE_URL="mysql://academy:password@localhost:3306/duradata_academy_test?sslmode=disable"

# --- App URL -------------------------------------------------------------
# Used to build absolute links in emails and as a fallback base URL.
# Set to the real Academy production domain in Hostinger.
APP_BASE_URL="https://academy.duradata.co.za"
APP_URL="https://academy.duradata.co.za"
NEXT_PUBLIC_APP_URL="https://academy.duradata.co.za"
ACADEMY_URL="https://academy.duradata.co.za"
ACADEMY_HOSTS="academy.duradata.co.za,academy.localhost"

# --- Paynow (Zimbabwe payments) ------------------------------------------
PAYNOW_INTEGRATION_ID=""
PAYNOW_INTEGRATION_KEY=""
PAYNOW_PAYMENT_LINK=""
PAYNOW_COMPANY_NAME=""
# Must point at the deployed domain, not localhost, once live.
PAYNOW_RETURN_URL="https://your-domain.example/dashboard/billing"
PAYNOW_RESULT_URL="https://your-domain.example/api/payments/paynow/callback"

# --- Outbound email (nodemailer/SMTP) ------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM_NAME="Duradata Academy"
EMAIL_FROM_ADDRESS="no-reply@academy.duradata.co.za"
SUPPORT_EMAIL="academy@duradata.co.za"
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME=""

# --- Password reset security ---------------------------------------------
PASSWORD_RESET_EXPIRY_MINUTES="30"
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES="15"
PASSWORD_RESET_MAX_REQUESTS_PER_EMAIL="3"
PASSWORD_RESET_MAX_REQUESTS_PER_IP="15"
PASSWORD_RESET_TOKEN_PEPPER=""

# --- Admin bootstrap (scripts/set-admin-password.ts) ---------------------
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- S3-compatible image storage -----------------------------------------
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="duradata-academy"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://cdn.your-domain.example"
S3_FORCE_PATH_STYLE="false"

# --- Existing Duradata website contact form ----------------------------
HOSTINGER_API_TOKEN=""
HOSTINGER_MAILBOX_RESOURCE_ID=""
CONTACT_TO_EMAIL="webrequest@duradata.co.za"
CONTACT_FROM_NAME="Duradata Website"
